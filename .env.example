# Copy this file to .env and adjust as needed.
# The app works with zero configuration - these are optional overrides.

# SQLite by default. Point this at a Postgres/MySQL URL to use a different DB.
DATABASE_URL=sqlite:///./data/liras.db

# Host/port used only if you run `python main.py` directly instead of uvicorn.
HOST=0.0.0.0
PORT=8000
